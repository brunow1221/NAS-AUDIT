# Puertos HTTP (sólo redirección/salud) y HTTPS publicados por Nginx.
APP_PORT=8092
APP_HTTPS_PORT=8443

# PostgreSQL: use secretos únicos, sin espacios ni comillas.
POSTGRES_DB=bcmetals_nas_audit
POSTGRES_USER=nas_audit
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# Cuenta creada solamente si todavía no existe ningún usuario administrador.
# Después del primer inicio y de cambiar la contraseña desde la aplicación, deje ambos valores vacíos.
INITIAL_ADMIN_EMAIL=admin@bcmetals.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_MINIMUM_14_CHARS

# false en producción. Si es true, se insertan datos sintéticos con dataMode=Demo.
DEMO_MODE=false

# Zona usada para presentación; la base siempre almacena UTC.
APP_TIMEZONE=America/Santiago
APP_ALLOWED_HOSTS=BCMETALSNAS;bcmetalsnas;bcmetalsnas.local;localhost;nas-audit-api
# Debe permanecer true en producción; HTTPS termina en Nginx.
COOKIE_SECURE=true
# Red Docker confiable observada con `docker network inspect`; no publique aquí la red real.
DOCKER_PROXY_NETWORK=CHANGE_ME_DOCKER_PROXY_NETWORK

# Sólo para los Compose opcionales de desarrollo/systemd.
DEV_DB_BIND_ADDRESS=CHANGE_ME_LOOPBACK_ADDRESS
SYSTEMD_LOOPBACK_ADDRESS=CHANGE_ME_LOOPBACK_ADDRESS

# Fase 3: genere al menos 32 bytes aleatorios. No reutilice contraseñas.
# El recolector queda desactivado hasta ejecutar Docker Compose con --profile collector.
COLLECTOR_TOKEN=CHANGE_ME
COLLECTOR_ID=bcmetalsnas-primary
# Sólo se usa con docker-compose.systemd.yml; confirme antes un puerto libre.
COLLECTOR_API_PORT=CHANGE_ME_FREE_LOOPBACK_PORT

# Obtenga este GID con scripts/diagnose-journald.sh antes de activar el perfil.
JOURNAL_PATH=/run/log/journal
JOURNAL_GID=CHANGE_ME_JOURNAL_GROUP_GID

# Ajustar solamente con los campos reales observados en el diagnóstico.
COLLECTOR_SOURCE_IDENTIFIERS=smbd
COLLECTOR_BATCH_SIZE=50
COLLECTOR_QUEUE_CAPACITY=500

# Retención: desactivada hasta que TI apruebe formalmente los plazos.
RETENTION_ENABLED=false
RETENTION_HISTORICAL_DAYS=2555
RETENTION_LIVE_DAYS=2555
RETENTION_DEMO_DAYS=90
RETENTION_INGESTION_METADATA_DAYS=365
RETENTION_REJECTED_EVENT_DAYS=365
RETENTION_BATCH_SIZE=5000
RETENTION_RUN_AT_UTC_HOUR=3

# Monitoreo y candidatos de alerta. Los candidatos conductuales están desactivados
# hasta disponer de una línea base; nunca se presentan como actividad maliciosa.
MONITORING_QUEUE_WARNING=100
MONITORING_NO_EVENT_HOURS=24
MONITORING_REJECTED_WARNING=1
ALERT_CANDIDATES_ENABLED=false
ALERT_WINDOW_MINUTES=15
ALERT_DELETION_THRESHOLD=50
ALERT_WRITE_THRESHOLD=500
ALERT_SENSITIVE_PATH_0=

# Límites iniciales conservadores; ajústelos sólo con mediciones del NAS.
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0
POSTGRES_SHM_SIZE=256m
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.5
COLLECTOR_MEMORY_LIMIT=256m
COLLECTOR_CPU_LIMIT=0.75
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.75

