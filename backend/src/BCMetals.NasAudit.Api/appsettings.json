{
  "App": {
    "TimeZone": "America/Santiago",
    "CookieSecure": false
  },
  "Demo": {
    "Enabled": false
  },
  "Retention": {
    "Enabled": false,
    "HistoricalDays": 2555,
    "LiveDays": 2555,
    "DemoDays": 90,
    "IngestionMetadataDays": 365,
    "RejectedEventDays": 365,
    "BatchSize": 5000,
    "RunAtUtcHour": 3
  },
  "Monitoring": {
    "QueueDepthWarning": 100,
    "NoEventWarningHours": 24,
    "RejectedEventsWarning24Hours": 1,
    "BehavioralCandidatesEnabled": false,
    "BehavioralWindowMinutes": 15,
    "DeletionCandidateThreshold": 50,
    "WriteCandidateThreshold": 500,
    "SensitivePathPrefixes": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}

